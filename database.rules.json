{
  "rules": {
    ".read": false,
    ".write": false,
    "inscricoes": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "status",
        "criadoEm"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && newData.exists() && (!data.exists() || data.child('status').val() == 'pendente') && newData.child('status').val() == 'pendente' && newData.child('visto').val() == false && newData.child('email').val() == auth.token.email && ((newData.child('planoId').val() == 'a-definir' && newData.child('valor').val() == 0) || newData.child('valor').val() == root.child('planos').child(newData.child('planoId').val()).child('preco').val())",
        ".validate": "newData.hasChildren(['uid', 'email', 'nome', 'cpf', 'whatsapp', 'sexo', 'idade', 'endereco', 'peso', 'altura', 'objetivo', 'lesao', 'saude', 'medicamento', 'diasTreino', 'tempoDia', 'planoId', 'planoNome', 'valor', 'diaVencimento', 'primeiroVencimento', 'lgpd', 'status', 'criadoEm']) && newData.child('uid').val() == $uid",
        "uid": {
          ".validate": "newData.isString()"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "provedor": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 120"
        },
        "cpf": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{11}$/)"
        },
        "whatsapp": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10,11}$/)"
        },
        "sexo": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 30"
        },
        "idade": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 100"
        },
        "endereco": {
          ".validate": "newData.hasChildren(['cep', 'rua', 'numero', 'bairro', 'cidade', 'uf'])",
          "cep": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8}$/)"
          },
          "rua": {
            ".validate": "newData.isString() && newData.val().length <= 150"
          },
          "numero": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "complemento": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "bairro": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "cidade": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "uf": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
          },
          "$outro": {
            ".validate": false
          }
        },
        "foto": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 400000"
        },
        "peso": {
          ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 400"
        },
        "altura": {
          ".validate": "newData.isNumber() && newData.val() >= 100 && newData.val() <= 250"
        },
        "objetivo": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "lesao": {
          ".validate": "newData.hasChildren(['tem'])",
          "tem": {
            ".validate": "newData.isBoolean()"
          },
          "qual": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "$outro": {
            ".validate": false
          }
        },
        "saude": {
          ".validate": "newData.hasChildren(['tem'])",
          "tem": {
            ".validate": "newData.isBoolean()"
          },
          "qual": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "$outro": {
            ".validate": false
          }
        },
        "medicamento": {
          ".validate": "newData.hasChildren(['tem'])",
          "tem": {
            ".validate": "newData.isBoolean()"
          },
          "qual": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "$outro": {
            ".validate": false
          }
        },
        "diasTreino": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7"
        },
        "tempoDia": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "planoId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "planoNome": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "valor": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "diaVencimento": {
          ".validate": "newData.isNumber() && (newData.val() == 5 || newData.val() == 10 || newData.val() == 15 || newData.val() == 20 || newData.val() == 25)"
        },
        "primeiroVencimento": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "responsavel": {
          ".validate": "newData.hasChildren(['nome', 'consentiu']) && newData.child('consentiu').val() == true",
          "nome": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "consentiu": {
            ".validate": "newData.isBoolean()"
          },
          "$outro": {
            ".validate": false
          }
        },
        "lgpd": {
          ".validate": "newData.child('aceito').val() == true && newData.child('saude').val() == true && newData.child('versao').isString() && newData.child('em').isNumber()"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(pendente|aprovada|ativo)$/)"
        },
        "visto": {
          ".validate": "newData.isBoolean()"
        },
        "criadoEm": {
          ".validate": "newData.isNumber()"
        },
        "alunoId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "aprovadoEm": {
          ".validate": "newData.isNumber()"
        },
        "primeiraFichaEm": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "alunos": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "email",
        "vencimento"
      ]
    },
    "emails": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$chave": {
        ".read": "auth != null && auth.token.email != null && $chave == auth.token.email.toLowerCase().replace('.', ',')"
      }
    },
    "fichas": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$alunoId": {
        ".read": "auth != null && auth.token.email != null && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val() == $alunoId && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false"
      }
    },
    "feedbacks": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br' || (auth != null && auth.token.email != null && query.orderByChild == 'alunoId' && query.equalTo == root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val())",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "alunoId",
        "criadoEm"
      ],
      "$id": {
        ".write": "!data.exists() && auth != null && auth.token.email != null && newData.child('alunoId').val() == root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false",
        ".validate": "newData.hasChildren(['alunoId', 'esforco', 'criadoEm', 'dia']) && newData.child('esforco').isString() && newData.child('esforco').val().matches(/^(minimo|medio|alto)$/) && (!newData.child('comentario').exists() || (newData.child('comentario').isString() && newData.child('comentario').val().length <= 1000))"
      }
    },
    "exercicios": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "categoria"
      ]
    },
    "biblioteca": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br' || (auth != null && auth.token.email != null && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false)",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'"
    },
    "arquivos": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$id": {
        ".validate": "newData.child('dados').isString() && newData.child('dados').val().length < 7500000",
        ".read": "(auth != null && auth.token.email != null && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false) && (root.child('biblioteca').child($id).child('para').val() != 'selecionados' || root.child('biblioteca').child($id).child('alunos').child(root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val()).exists())"
      }
    },
    "financeiro": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "data"
      ]
    },
    "planos": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "ordem"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['nome']) && newData.child('nome').isString() && newData.child('nome').val().length <= 60 && (!newData.child('preco').exists() || newData.child('preco').isNumber())"
      }
    },
    "config": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "pix": {
        ".validate": "newData.hasChildren(['tipo', 'chave', 'nome', 'cidade']) && newData.child('tipo').val().matches(/^(cpf|cnpj|email|telefone|aleatoria)$/) && newData.child('chave').isString() && newData.child('chave').val().length <= 77 && newData.child('nome').isString() && newData.child('nome').val().length <= 25",
        ".read": "(auth != null && auth.token.email != null && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).exists() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false)"
      }
    },
    "depoimentos": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br' || (auth != null && auth.token.email != null && query.orderByChild == 'alunoId' && query.equalTo == root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val())",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "alunoId",
        "criadoEm"
      ],
      "$id": {
        ".write": "!data.exists() && auth != null && auth.token.email != null && newData.child('alunoId').val() == root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false && newData.child('publicado').val() == false && newData.child('visto').val() == false",
        ".validate": "newData.hasChildren(['alunoId', 'nome', 'texto', 'nota', 'criadoEm', 'autorizado']) && newData.child('texto').isString() && newData.child('texto').val().length >= 20 && newData.child('texto').val().length <= 600 && newData.child('nota').isNumber() && newData.child('nota').val() >= 1 && newData.child('nota').val() <= 5 && newData.child('autorizado').val() == true && (!newData.child('nomeExibicao').exists() || (newData.child('nomeExibicao').isString() && newData.child('nomeExibicao').val().length <= 80))"
      }
    },
    "depoimentosPublicos": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$id": {
        ".validate": "newData.hasChildren(['nome', 'texto', 'nota']) && newData.child('texto').isString() && newData.child('texto').val().length <= 600 && newData.child('nota').isNumber()"
      }
    },
    "vitrine": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "video": {
        ".validate": "newData.hasChildren(['id']) && newData.child('id').isString() && newData.child('id').val().matches(/^[A-Za-z0-9_-]{11}$/)"
      },
      "principal": {
        ".validate": "newData.hasChildren(['src'])",
        "src": {
          ".validate": "newData.isString() && newData.val().length < 1000000 && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('./administrador/Assets/img/'))"
        }
      },
      "sobre": {
        "$id": {
          ".validate": "newData.hasChildren(['src', 'ordem']) && newData.child('ordem').isNumber()",
          "src": {
            ".validate": "newData.isString() && newData.val().length < 1000000 && (newData.val().beginsWith('data:image/') || newData.val().beginsWith('./administrador/Assets/img/'))"
          }
        }
      },
      "textos": {
        "$chave": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 600"
        }
      },
      "$outro": {
        ".validate": false
      }
    },
    "perfis": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "foto": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 400000"
        },
        "tema": {
          ".validate": "newData.isString() && (newData.val() == 'claro' || newData.val() == 'escuro')"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "avaliacoes": {
      ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      ".indexOn": [
        "expiraEm",
        "criadoEm"
      ],
      "$id": {
        ".write": "!data.exists() && auth != null && auth.token.email != null && newData.child('uid').val() == auth.uid && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('aluno').val() == newData.child('alunoId').val() && root.child('emails').child(auth.token.email.toLowerCase().replace('.', ',')).child('ativo').val() != false && newData.child('visto').val() == false && newData.child('criadoEm').val() <= now + 60000 && newData.child('criadoEm').val() >= now - 600000 && newData.child('expiraEm').val() == newData.child('criadoEm').val() + 1296000000",
        ".validate": "newData.hasChildren(['uid', 'alunoId', 'nome', 'criadoEm', 'expiraEm', 'visto'])",
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "alunoId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "obs": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "criadoEm": {
          ".validate": "newData.isNumber()"
        },
        "expiraEm": {
          ".validate": "newData.isNumber()"
        },
        "visto": {
          ".validate": "newData.isBoolean()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "avaliacoesFotos": {
      ".write": "auth != null && auth.token.email == 'contato@fagnerlage.com.br'",
      "$id": {
        ".read": "auth != null && auth.token.email == 'contato@fagnerlage.com.br' && root.child('avaliacoes').child($id).child('expiraEm').val() > now",
        ".write": "!data.exists() && auth != null && newData.parent().parent().child('avaliacoes').child($id).child('uid').val() == auth.uid",
        ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 1500000"
      }
    }
  }
}
